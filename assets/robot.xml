<mujoco model="cxr_arm">
  <!--
    5-DOF arm with a single actuated "finger" (a plunger) used for both key presses and
    mouse clicks.

    Kinematics: base yaw -> shoulder pitch -> elbow pitch -> wrist pitch -> wrist roll.
    With all joints at zero the arm points straight forward (+x). The nominal working pose
    has shoulder + elbow + wrist_pitch = 90 deg, so the hand points straight down; in that
    pose the hand frame is aligned with the world frame (x forward, y left, z up).

    Sites:
      tool       palm-bottom height, directly above the finger (the retracted fingertip is
                 3.5 mm above the palm bottom). This is the IK target point:
                 hovering it over a key puts the finger over the key, and resting it on the
                 mouse puts the palm on the mouse shell with the finger over the button.
      fingertip  bottom of the finger.

    Collision groups: robot geoms use contype=1/conaffinity=0, environment geoms use
    contype=0/conaffinity=1, so the robot touches the environment but nothing else collides
    (no self-collision, no key-vs-keyboard collisions).
  -->
  <default>
    <default class="arm">
      <joint damping="1.0" armature="0.05"/>
      <geom contype="1" conaffinity="0" friction="1.2 0.02 0.001" rgba="0.90 0.91 0.93 1"/>
      <default class="arm_dark">
        <geom rgba="0.16 0.17 0.19 1"/>
      </default>
      <default class="arm_visual">
        <geom contype="0" conaffinity="0" group="1" mass="0" rgba="0.16 0.17 0.19 1"/>
      </default>
    </default>
  </default>

  <worldbody>
    <body name="robot_base" pos="0 0 0" childclass="arm">
      <geom name="pedestal" type="cylinder" size="0.09 0.425" pos="0 0 0.425" class="arm_dark"/>
      <geom name="pedestal_foot" type="cylinder" size="0.18 0.015" pos="0 0 0.015" class="arm_dark"/>
      <!-- Sensor mast carrying the robot's perception camera, mounted to the left of the arm. -->
      <geom name="mast" type="capsule" fromto="-0.08 0.10 0.70  -0.09 0.45 1.64" size="0.015" class="arm_visual"/>
      <geom name="mast_head" type="box" size="0.035 0.05 0.03" pos="-0.09 0.45 1.68" class="arm_visual"/>
      <camera name="robot_cam" pos="-0.05 0.45 1.68" fovy="55"
              xyaxes="-0.525 -0.851 0.000 0.565 -0.348 0.748"/>

      <body name="link_yaw" pos="0 0 0.85" gravcomp="1">
        <joint name="yaw" axis="0 0 1" range="-150 150"/>
        <geom name="turret" type="cylinder" size="0.075 0.075" pos="0 0 0.075" mass="3"/>

        <body name="upper_arm" pos="0 0 0.15" gravcomp="1">
          <joint name="shoulder" axis="0 1 0" range="-115 60"/>
          <geom name="shoulder_hub" type="cylinder" size="0.06 0.06" zaxis="0 1 0" mass="0.8" class="arm_dark"/>
          <geom name="upper_arm" type="capsule" fromto="0 0 0  0.40 0 0" size="0.045" mass="2.0"/>

          <body name="forearm" pos="0.40 0 0" gravcomp="1">
            <joint name="elbow" axis="0 1 0" range="0 165"/>
            <geom name="elbow_hub" type="cylinder" size="0.05 0.05" zaxis="0 1 0" mass="0.5" class="arm_dark"/>
            <geom name="forearm" type="capsule" fromto="0 0 0  0.36 0 0" size="0.035" mass="1.4"/>

            <body name="wrist" pos="0.36 0 0" gravcomp="1">
              <joint name="wrist_pitch" axis="0 1 0" range="-60 160"/>
              <geom name="wrist_hub" type="cylinder" size="0.038 0.04" zaxis="0 1 0" mass="0.2" class="arm_dark"/>
              <geom name="wrist" type="capsule" fromto="0 0 0  0.08 0 0" size="0.028" mass="0.3"/>

              <!-- euler="0 -90 0" makes the hand frame world-aligned in the hand-down pose. -->
              <body name="hand" pos="0.08 0 0" euler="0 -90 0" gravcomp="1">
                <joint name="wrist_roll" axis="0 0 1" range="-180 180"/>
                <geom name="palm" type="box" size="0.025 0.03 0.012" pos="0 0 -0.028" mass="0.3" class="arm_dark"/>
                <geom name="finger_housing" type="box" size="0.009 0.009 0.012" pos="0.045 0 -0.02" mass="0.05" class="arm_dark"/>
                <geom name="knuckle" type="box" size="0.012 0.012 0.005" pos="0.032 0 -0.017" class="arm_visual"/>
                <site name="tool" pos="0.045 0 -0.04" size="0.004" rgba="1 0.3 0.1 0.8" group="4"/>
                <camera name="wrist_cam" pos="-0.03 0.05 -0.036" fovy="80" xyaxes="-0.530 -0.848 0.000 0.324 -0.202 0.924"/>

                <body name="finger" pos="0.045 0 -0.03" gravcomp="1">
                  <joint name="finger" type="slide" axis="0 0 -1" range="0 0.03" damping="2" armature="0.01"/>
                  <geom name="finger" type="capsule" fromto="0 0 0.012  0 0 -0.0015" size="0.005" mass="0.02"
                        rgba="0.95 0.55 0.15 1"/>
                  <site name="fingertip" pos="0 0 -0.0065" size="0.003" rgba="1 0 0 1" group="4"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="yaw" joint="yaw" kp="1500" dampratio="1" inheritrange="1" forcerange="-200 200"/>
    <position name="shoulder" joint="shoulder" kp="3000" dampratio="1" inheritrange="1" forcerange="-300 300"/>
    <position name="elbow" joint="elbow" kp="2000" dampratio="1" inheritrange="1" forcerange="-200 200"/>
    <position name="wrist_pitch" joint="wrist_pitch" kp="600" dampratio="1" inheritrange="1" forcerange="-60 60"/>
    <position name="wrist_roll" joint="wrist_roll" kp="200" dampratio="1" inheritrange="1" forcerange="-20 20"/>
    <position name="finger" joint="finger" kp="600" dampratio="1" inheritrange="1" forcerange="-15 15"/>
  </actuator>

  <sensor>
    <framepos name="tool_pos" objtype="site" objname="tool"/>
    <framepos name="fingertip_pos" objtype="site" objname="fingertip"/>
  </sensor>
</mujoco>
